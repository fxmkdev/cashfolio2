{
  "name": "cashfolio-app2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm build:contracts && vite dev",
    "build": "pnpm build:contracts && vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-runtime-cycles.ts",
    "typecheck": "pnpm build:contracts && tsc --noEmit",
    "format": "prettier --check .",
    "test:mutations": "pnpm build:contracts && pnpm prisma:generate && vitest run --config vitest.mutations.config.ts",
    "pretest:unit": "pnpm prisma:generate",
    "test:unit": "pnpm build:contracts && vitest run --config vitest.unit.config.ts",
    "pretest:unit:coverage": "pnpm prisma:generate",
    "test:unit:coverage": "pnpm build:contracts && vitest run --config vitest.unit.config.ts --coverage",
    "coverage:ratchet": "node ./scripts/check-coverage-ratchet.mjs",
    "coverage:ratchet:accept": "node ./scripts/update-coverage-baseline.mjs",
    "test:unit:coverage:ratchet": "pnpm test:unit:coverage && pnpm coverage:ratchet",
    "storybook": "pnpm build:contracts && storybook dev -p 6006",
    "build-storybook": "pnpm build:contracts && storybook build",
    "test-storybook": "pnpm build:contracts && vitest run --project storybook",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --exit-zero-on-changes --auto-accept-changes",
    "prisma:generate": "prisma generate",
    "e2e:install": "playwright install chromium",
    "e2e": "APP_ENVIRONMENT=e2e DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5433/postgres?schema=public} BASE_URL=${BASE_URL:-http://127.0.0.1:4173} E2E_AUTH_EXTERNAL_ID=${E2E_AUTH_EXTERNAL_ID:-e2e-user} sh -c 'pnpm prisma:generate && pnpm exec prisma migrate deploy && playwright test'",
    "e2e:ci": "APP_ENVIRONMENT=e2e sh -c 'pnpm prisma:generate && playwright test ${E2E_SHARD:+--shard=$E2E_SHARD}'",
    "test-storybook:coverage": "pnpm build:contracts && vitest run --project storybook --coverage",
    "build:staging-seed": "vite build --config vite.staging-seed.config.ts",
    "build:provider-usage-cleanup": "vite build --config vite.provider-usage-cleanup.config.ts",
    "cleanup:provider-usage": "node dist/provider-usage-cleanup/cleanup.mjs",
    "test:provider-usage-cleanup": "pnpm build:contracts && pnpm prisma:generate && pnpm build:provider-usage-cleanup && vitest run --config vitest.provider-usage-cleanup.config.ts",
    "test:provider-usage-cleanup-runner": "node --test scripts/run-provider-usage-cleanup.test.ts",
    "seed:staging": "node dist/staging-seed/seed.mjs --manual",
    "test:staging-seed": "pnpm build:contracts && pnpm prisma:generate && vitest run --config vitest.staging-seed.config.ts",
    "build:e2e": "pnpm build:contracts && vite build --mode e2e",
    "test:build-boundary": "node --test scripts/build-boundary.test.ts",
    "build:contracts": "pnpm --filter @cashfolio/book-cache-contracts build"
  },
  "dependencies": {
    "@cashfolio/book-cache-contracts": "workspace:*",
    "@logto/node": "^4.0.2",
    "@mantine/core": "^9.8.2",
    "@mantine/dates": "^9.8.2",
    "@mantine/dropzone": "^9.8.2",
    "@mantine/form": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@mantine/nprogress": "^9.8.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "ag-charts-community": "^14.3.0",
    "ag-charts-enterprise": "^14.3.0",
    "ag-charts-react": "^14.3.0",
    "ag-grid-enterprise": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "decimal.js": "^10.6.0",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-number-format": "^5.4.5",
    "redis": "^6.3.1",
    "temporal-polyfill": "^1.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/utils": "8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "chromatic": "^18.15.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "msw": "^3.0.7",
    "nitro": "3.0.260429-beta",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "^7.10.1",
    "storybook": "^10.6.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  }
}
