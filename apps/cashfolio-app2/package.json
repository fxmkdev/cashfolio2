{
  "name": "cashfolio-app2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "pretest:unit": "pnpm prisma:generate",
    "test:unit": "vitest run",
    "pretest:unit:coverage": "pnpm prisma:generate",
    "test:unit:coverage": "vitest run --coverage",
    "coverage:ratchet": "node ./scripts/check-coverage-ratchet.mjs",
    "coverage:ratchet:accept": "node ./scripts/update-coverage-baseline.mjs",
    "test:unit:coverage:ratchet": "pnpm test:unit:coverage && pnpm coverage:ratchet",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "NPM_CONFIG_CACHE=${NPM_CONFIG_CACHE:-/tmp/.npm-cache} test-storybook --url http://127.0.0.1:6006",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --exit-zero-on-changes --auto-accept-changes",
    "prisma:generate": "prisma generate",
    "e2e:install": "playwright install chromium",
    "e2e": "E2E_TEST_MODE=${E2E_TEST_MODE:-true} DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5433/postgres?schema=public} BASE_URL=${BASE_URL:-http://127.0.0.1:4173} E2E_AUTH_BYPASS=${E2E_AUTH_BYPASS:-true} E2E_AUTH_EXTERNAL_ID=${E2E_AUTH_EXTERNAL_ID:-e2e-user} sh -c 'pnpm prisma:generate && pnpm exec prisma migrate deploy && playwright test'",
    "e2e:ci": "E2E_TEST_MODE=${E2E_TEST_MODE:-true} sh -c 'pnpm prisma:generate && playwright test ${E2E_SHARD:+--shard=$E2E_SHARD}'"
  },
  "dependencies": {
    "@logto/node": "^4.0.0",
    "@mantine/core": "^9.7.1",
    "@mantine/dates": "^9.7.1",
    "@mantine/dropzone": "^9.7.1",
    "@mantine/form": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@mantine/nprogress": "^9.7.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "ag-charts-community": "^14.2.0",
    "ag-charts-enterprise": "^14.2.0",
    "ag-charts-react": "^14.2.0",
    "ag-grid-enterprise": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-number-format": "^5.4.5",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@storybook/test-runner": "0.24.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^24.19.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chromatic": "^18.11.0",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "msw": "^2.15.0",
    "nitro": "3.0.260429-beta",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "^7.10.0",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "^4.1.11"
  }
}
