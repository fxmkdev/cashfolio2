// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/.prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
}

enum EquityAccountSubtype {
  GAIN_LOSS
  OPENING_BALANCES
  INCOME
  EXPENSE
}

enum Unit {
  CURRENCY
  CRYPTOCURRENCY
  SECURITY
}

enum UserRole {
  ADMIN
}

enum ValuationProviderName {
  CURRENCYLAYER
  COINLAYER
  MARKETSTACK
}

enum ValuationProviderUnitType {
  CURRENCY
  CRYPTOCURRENCY
  SECURITY
}

enum ValuationProviderRequestOutcome {
  RETRIEVED
  NO_DATA
  MISSING_RATE
  TIMEOUT
  HTTP_ERROR
  PROVIDER_ERROR
  REQUEST_ERROR
  RATE_LIMIT_RETRY
}

enum ValuationProviderRequestReason {
  INITIAL_PROBE
  BACKTRACK_PROBE
  RATE_LIMIT_RETRY
}

model User {
  id         String @id @default(cuid())
  externalId String @unique

  locale String?

  accountBookLinks UserAccountBookLink[]

  roles UserRole[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserAccountBookLink {
  userId        String
  accountBookId String

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountBook AccountBook @relation(fields: [accountBookId], references: [id], onDelete: Cascade)

  @@id([userId, accountBookId])
}

model AccountBook {
  id                String @default(cuid())
  name              String
  referenceCurrency String
  startDate         DateTime

  groups       AccountGroup[]
  accounts     Account[]
  transactions Transaction[]
  bookings     Booking[]

  userLinks UserAccountBookLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([id])
}

model AccountGroup {
  id                   String                @default(cuid())
  name                 String
  type                 AccountType
  equityAccountSubtype EquityAccountSubtype?
  isActive             Boolean               @default(true)
  sortOrder            Int?
  isCashAccount        Boolean               @default(false)

  parentGroup   AccountGroup? @relation("parent-child", fields: [parentGroupId, accountBookId], references: [id, accountBookId], onDelete: Restrict)
  parentGroupId String?

  childGroups AccountGroup[] @relation("parent-child")
  accounts    Account[]

  accountBook   AccountBook @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  accountBookId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([id, accountBookId])
  @@index([accountBookId, type, equityAccountSubtype, isActive])
  @@index([accountBookId, parentGroupId, isActive])
}

model Account {
  id                   String                @default(cuid())
  name                 String
  type                 AccountType
  equityAccountSubtype EquityAccountSubtype?
  isActive             Boolean               @default(true)
  sortOrder            Int?

  group   AccountGroup? @relation(fields: [groupId, accountBookId], references: [id, accountBookId], onDelete: Restrict)
  groupId String?

  unit           Unit?
  currency       String?
  cryptocurrency String?
  symbol         String?
  tradeCurrency  String?
  isCashAccount  Boolean @default(false)

  statementImportCsvFormat Json?

  bookings Booking[]

  accountBook   AccountBook @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  accountBookId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([id, accountBookId])
  @@index([accountBookId, isActive, type, equityAccountSubtype])
  @@index([accountBookId, groupId, isActive])
}

model Transaction {
  id          String @default(cuid())
  description String

  bookings Booking[]

  accountBook   AccountBook @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  accountBookId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([id, accountBookId])
}

model Booking {
  id          String   @default(cuid())
  date        DateTime
  description String

  transactionId String
  transaction   Transaction @relation(fields: [transactionId, accountBookId], references: [id, accountBookId], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId, accountBookId], references: [id, accountBookId])

  unit           Unit
  currency       String?
  cryptocurrency String?
  symbol         String?
  tradeCurrency  String?

  value     Decimal
  sortOrder Int     @default(0)

  accountBook   AccountBook @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  accountBookId String

  @@id([id, accountBookId])
  @@index([accountBookId, accountId, date])
  @@index([accountBookId, date])
  @@index([accountBookId, transactionId, date])
}

model ValuationProviderRequest {
  id String @id @default(cuid())

  provider      ValuationProviderName
  unitType      ValuationProviderUnitType
  outcome       ValuationProviderRequestOutcome
  requestReason ValuationProviderRequestReason

  requestedAt   DateTime @default(now())
  valuationDate DateTime

  currency       String?
  cryptocurrency String?
  symbol         String?
  tradeCurrency  String?

  httpStatus  Int?
  durationMs  Int
  retryCount  Int     @default(0)
  errorMessage String?

  @@index([requestedAt])
  @@index([provider, requestedAt])
  @@index([outcome, requestedAt])
  @@index([requestReason, requestedAt])
}
