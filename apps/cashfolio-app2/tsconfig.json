{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite.staging-seed.config.ts",
    "vite.provider-usage-cleanup.config.ts",
    "vitest.provider-usage-cleanup.config.ts",
    "vitest.staging-seed.config.ts"
  ]
}
