{
  "name": "cli",
  "version": "0.0.0-unknown",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "pnpm build:contracts && tsx src/index.ts",
    "typecheck": "pnpm build:contracts && tsc",
    "test": "pnpm build:contracts && tsx --test src/book-cache-cleanup.test.ts src/restore-local.test.ts src/restore-redis-client.test.ts",
    "build:contracts": "pnpm --filter @cashfolio/book-cache-contracts build"
  },
  "dependencies": {
    "@cashfolio/book-cache-contracts": "workspace:*",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
